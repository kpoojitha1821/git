     "text": [
      "Enter a string:  poojitha\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reversed string: ahtijoop\n"
     ]
    }
   ],
   "source": [
    "s = list(input(\"Enter a string: \"))\n",
    "left = 0\n",
    "right = len(s) - 1\n",
    "while left < right:\n",
    "    s[left], s[right] = s[right], s[left]\n",
    "    left += 1\n",
    "    right -= 1\n",
    "print(\"Reversed string:\", \"\".join(s))"
   ]
  },
