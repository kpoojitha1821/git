   "source": [
    "def find_largest(numbers):\n",
    "    largest = numbers[0]\n",
    "\n",
    "    for n in numbers:\n",
    "        if n > largest:\n",
    "            largest = n\n",
    "\n",
    "    return largest\n",
    "\n",
    "print(find_largest([10, 25, 15, 40, 5]))"
   ]
