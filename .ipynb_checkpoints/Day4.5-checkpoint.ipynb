   "source": [
    "numbers = input(\"enter a number:\")\n",
    "seen = set()\n",
    "duplicates = set()\n",
    "for num in numbers:\n",
    "    if num in seen:\n",
    "        duplicates.add(num)\n",
    "    else:\n",
    "        seen.add(num)\n",
    "print(\"Duplicates:\", list(duplicates))\n"
   ]
