   "source": [
    "text = input(\"Enter a sentence: \")\n",
    "words = text.split()\n",
    "count = {}\n",
    "for word in words:\n",
    "    if word in count:\n",
    "        count[word] += 1\n",
    "    else:\n",
    "        count[word] = 1\n",
    "print(count)"
   ]
